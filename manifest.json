{
  "manifest_version": 3,
  "name": "MamaCat Video Generator",
  "version": "1.0.0",
  "description": "Automate Google Veo video generation with ingredients and prompts",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "action": {
    "default_title": "Open MamaCat Sidebar"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_page": "test-sidebar.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["automation-core.js", "automation-core-debug.js"],
      "matches": ["https://labs.google/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
